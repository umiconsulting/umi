# Copy this file to deploy/pilot/pilot.env. Set mode 0600.
COMPOSE_PROJECT_NAME=umipos-pilot
PILOT_NODE_BIN=node
UMI_ENVIRONMENT=pilot
NODE_ENV=production
PILOT_DOMAIN=localhost
PUBLIC_API_URL=https://localhost
PUBLIC_DASHBOARD_URL=https://localhost
CORS_ORIGINS=https://localhost
TRUSTED_PROXY_CIDRS=172.31.64.10/32

RELEASE_VERSION=6.0.0-pilot.1
RELEASE_GIT_COMMIT=0000000000000000000000000000000000000000
RELEASE_BUILD_TIMESTAMP=2026-08-11T00:00:00.000Z
CONTRACT_VERSION=2.12.0
EXPECTED_SCHEMA_VERSION=build-v3-47
CONFIG_SCHEMA_VERSION=1
# Initial control-plane bootstrap. Inject secrets outside source control.
PILOT_BOOTSTRAP_TOKEN=CHANGE_ME_MINIMUM_32_CHARACTERS
PILOT_BOOTSTRAP_EXPIRES_AT=2026-12-31T23:59:59.000Z
PILOT_BOOTSTRAP_OWNER_EMAIL=CHANGE_ME_INITIAL_OWNER_EMAIL
PILOT_BOOTSTRAP_OWNER_NAME=CHANGE_ME_INITIAL_OWNER_NAME
PILOT_BOOTSTRAP_OWNER_PASSWORD=CHANGE_ME_INITIAL_OWNER_PASSWORD
PILOT_BOOTSTRAP_OWNER_USER_ID=CHANGE_ME_INITIAL_OWNER_UUID
PILOT_BOOTSTRAP_OWNER_STAFF_ID=CHANGE_ME_INITIAL_OWNER_STAFF_UUID
PILOT_BOOTSTRAP_COMMAND_ID=CHANGE_ME_BOOTSTRAP_COMMAND_UUID
PILOT_BOOTSTRAP_IDEMPOTENCY_KEY=CHANGE_ME_BOOTSTRAP_IDEMPOTENCY_KEY
MINIMUM_POS_VERSION=0.1.0
MINIMUM_DASHBOARD_VERSION=0.2.0

POSTGRES_DB=umipos_pilot
POSTGRES_PASSWORD=CHANGE_ME_SUPERUSER_PASSWORD
UMIPOS_DB_APP_PASSWORD=CHANGE_ME_APP_PASSWORD
UMIPOS_DB_WORKER_PASSWORD=CHANGE_ME_WORKER_PASSWORD
DATABASE_URL_APP=postgresql://umi_api_login:CHANGE_ME_APP_PASSWORD@postgres:5432/umipos_pilot
DATABASE_URL_WORKER=postgresql://umi_worker_login:CHANGE_ME_WORKER_PASSWORD@postgres:5432/umipos_pilot
DATABASE_TLS_MODE=disable
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379

JWT_SECRET=CHANGE_ME_32_CHAR_SESSION_AND_PIN_KEY
APP_QR_SECRET=CHANGE_ME_32_CHAR_CASH_QR_SIGNING_KEY
JWT_ACCESS_SECRET=CHANGE_ME_32_CHAR_CUSTOMER_ACCESS_KEY
JWT_REFRESH_SECRET=CHANGE_ME_32_CHAR_CUSTOMER_REFRESH_KEY
MFA_OTP_PEPPER=CHANGE_ME_32_CHAR_MFA_PEPPER
CUSTOMER_VALUE_SECRET=CHANGE_ME_32_CHAR_VALUE_KEY
OPERATIONS_TOKEN=CHANGE_ME_32_CHAR_OPERATIONS_TOKEN
COOKIE_SECURE=true
COOKIE_SAMESITE=strict
APP_URL=https://localhost

OUTBOX_RELAY_ENABLED=true
CUSTOMER_VALUE_EXPIRY_ENABLED=true
LIFECYCLE_CRONS_ENABLED=false
KDS_STATUS_NOTIFY_ENABLED=false
LEADS_SEQUENCE_ENABLED=false
CASH_WRITE_ENABLED=false
ALLOW_INSECURE_TWILIO_WEBHOOK=false
RATE_LIMIT_IP_PER_MINUTE=300
STARTUP_RETRY_ATTEMPTS=5
STARTUP_RETRY_DELAY_MS=1000

OBJECT_STORAGE_ENABLED=false
OTEL_SDK_DISABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OBSERVABILITY_SCHEMA=conversaflow
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Disposable clean-deployment certification only.
# SMOKE_DASHBOARD_USERNAME=owner@umipos.local
# SMOKE_DASHBOARD_PASSWORD=CHANGE_ME_CERTIFICATION_PASSWORD
# SMOKE_MERCHANT_ID=10000000-0000-4000-8000-000000000101
# SMOKE_LOCATION_ID=20000000-0000-4000-8000-000000000101
# SMOKE_DEVICE_ID=67000000-0000-4000-8000-000000000101
# SMOKE_INSTALLATION_ID=67000000-0000-4000-8000-000000000102
# SMOKE_DEVICE_CREDENTIAL=CHANGE_ME_DISPOSABLE_DEVICE_CREDENTIAL
# SMOKE_POS_PIN=CHANGE_ME_DISPOSABLE_POS_PIN
# PILOT_CERTIFICATION_CONFIRM=disposable
# PILOT_CURL_INSECURE=false
# MIN_FREE_DISK_KB=5242880
