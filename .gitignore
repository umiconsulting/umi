# macOS
.DS_Store

# apps/ are tracked in this monorepo (fresh-snapshot migration 2026-06-20).
# Per-app .gitignore files still apply within each app subtree.

# Local, non-repo working files — never version data payloads or scratch dirs
backups/
prod-db-handoff-2026-05-13/
*.dump
*.sql.gz
artifacts/
.hermes/
*.tar.gz.enc

# Screenshots / visual artifacts
artifacts/

# Env and secrets — templates are tracked, real env files never are
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.p12
*.p8

# Build outputs
node_modules/
dist/
build/
.next/
**/.dart_tool/

# Generated Dart SDK package metadata
packages/contract/generated/dart/pubspec.lock

# Exception: packages/tokens ships its generator (build/) AND its generated output
# (dist/) in git. The frontends deploy as separate Vercel projects that run an
# app-scoped `npm install` + `npm run build` and never execute the monorepo token
# generator, so the committed dist/ is what they consume. tokens-ci.yml keeps it fresh.
!packages/tokens/build/
!packages/tokens/build/**
!packages/tokens/dist/
!packages/tokens/dist/**

# Turborepo cache
.turbo/
.vercel
.env*

# CodeGraph local SQLite index
.codegraph/

# Supabase CLI scratch. Written by `supabase link`/`db` commands; holds the linked
# project ref and a pooler URL. Machine-local state, not source — and umi-cash is
# frozen, so nothing here should ever be committed.
apps/*/supabase/.temp/
supabase/.temp/

# Python bytecode and test caches. Generated on import, version-stamped
# (cpython-314), and useless on a machine with a different interpreter — the
# .agents/skills/design/* skills ship Python scripts, so these appear locally.
__pycache__/
*.py[cod]
.pytest_cache/
*.pyc
# Pilot runtime secrets
deploy/pilot/pilot.env

# Claude Code per-developer settings. Contains machine-specific permission
# allowlists that have historically included credentials in command strings.
# The repo-shared config is .mcp.json (secrets via ${VAR} expansion only).
.claude/settings.local.json

# Playwright CLI runtime artifacts (snapshots, console logs)
.playwright-cli/
.playwright/

# ---- Bulk research harvests -------------------------------------------------
# The competitor screenshot HARVESTS are not committed. Measured 2026-09-18: the
# five folders below hold 193 images and 53 MB, which is 24x the 2.4 MB of research
# images the repository already tracks, against a 91 MB .git.
#
# Every image in them is reproducible: the INDEX.md beside each folder records the
# app id, the source URL, the device class, and what the screen shows, and the
# video and ugc indexes record the exact timestamp for every frame. A reviewer
# needs the index, not the binary.
#
# The curated evidence the reports actually reference IS committed: the eight
# official Lightspeed screenshots at the root of this folder, and the before/after
# screen sets under docs/research/2026-09-18-design-taste/assets/screens/.
docs/research/2026-09-18-inventory-surface-placement/assets/store/*.png
docs/research/2026-09-18-inventory-surface-placement/assets/store/*.jpg
docs/research/2026-09-18-inventory-surface-placement/assets/store/*.jpeg
docs/research/2026-09-18-inventory-surface-placement/assets/video/*.png
docs/research/2026-09-18-inventory-surface-placement/assets/video/*.jpg
docs/research/2026-09-18-inventory-surface-placement/assets/video/*.jpeg
docs/research/2026-09-18-inventory-surface-placement/assets/ugc/**/*.png
docs/research/2026-09-18-inventory-surface-placement/assets/ugc/**/*.jpg
docs/research/2026-09-18-inventory-surface-placement/assets/ugc/**/*.jpeg
docs/research/2026-09-18-inventory-surface-placement/assets/ugc/**/*.webp
docs/research/2026-09-18-inventory-surface-placement/assets/independent/*.png
docs/research/2026-09-18-inventory-surface-placement/assets/marketplace/*.png
