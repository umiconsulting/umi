{
  "name": "umi-workspace",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint --continue",
    "check:lint-warnings": "node scripts/check-lint-warning-baseline.mjs",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:pr": "pnpm --filter @umi/contract generate:check && pnpm umi-pos:check-pilot-rbac && pnpm lint && pnpm check:lint-warnings && pnpm format:check && node scripts/check-pr.mjs && node scripts/check-umipos-use-cases.mjs",
    "db:build-v3": "bash docs/migration/build-v3/00_run.sh",
    "db:pos-check": "bash scripts/umi-pos-db-check.sh",
    "umi-pos:get": "cd apps/umi-pos && flutter pub get",
    "umi-pos:generate": "pnpm --filter @umi/contract generate && cd apps/umi-pos && flutter gen-l10n",
    "umi-pos:linux": "cd apps/umi-pos && flutter run -d linux",
    "umi-pos:macos": "cd apps/umi-pos && flutter run -d macos",
    "umi-pos:windows": "cd apps/umi-pos && flutter run -d windows",
    "umi-pos:android": "cd apps/umi-pos && flutter run -d android",
    "umi-pos:ios": "cd apps/umi-pos && flutter run -d ios",
    "umi-pos:web": "cd apps/umi-pos && flutter run -d chrome",
    "umi-pos:offline-tests": "cd apps/umi-pos && flutter test test/offline_journal_test.dart test/offline_policy_test.dart test/checkout_test.dart",
    "umi-pos:replay-api-tests": "pnpm --filter @umi/api exec vitest run src/modules/pos-offline/pos-offline.service.spec.ts",
    "umi-pos:pairing-db-check": "bash scripts/umi-pos-device-pairing-db-check.sh",
    "umi-pos:offline-db-check": "bash scripts/umi-pos-offline-db-check.sh",
    "umi-pos:pairing-tests": "cd apps/umi-pos && flutter test test/device_pairing_test.dart",
    "umi-pos:pairing-api-tests": "pnpm --filter @umi/api exec vitest run src/modules/devices/devices.service.spec.ts src/shared/database/device-pairing-migration.spec.ts",
    "umi-pos:local-access-seed": "bash scripts/umi-pos-local-access-seed.sh",
    "umi-pos:demo-seed": "bash scripts/umi-pos-demo-seed.sh",
    "umi-pos:sale-api-tests": "pnpm --filter @umi/api exec vitest run src/modules/pos-sale/pos-sale.service.spec.ts src/modules/pos-cart/pos-cart.service.spec.ts src/modules/pos-checkout/pos-checkout.service.spec.ts",
    "umi-pos:sale-tests": "cd apps/umi-pos && flutter test test/sale_lifecycle_test.dart test/cart_test.dart test/checkout_test.dart test/catalog_test.dart test/navigation_test.dart",
    "umi-pos:checkout-api-tests": "pnpm --filter @umi/api exec vitest run src/modules/pos-checkout/checkout-calculator.spec.ts src/modules/pos-checkout/pos-checkout.service.spec.ts src/modules/pos-checkout/pos-checkout.repository.spec.ts src/modules/pos-entry/pos-entry.service.spec.ts",
    "umi-pos:checkout-tests": "cd apps/umi-pos && flutter test test/checkout_test.dart test/sale_lifecycle_test.dart",
    "umi-pos:cash-api-tests": "pnpm --filter @umi/api exec vitest run src/modules/pos-cash/cash-domain.spec.ts src/modules/pos-cash/pos-cash.service.spec.ts src/modules/pos-checkout/pos-checkout.repository.spec.ts",
    "umi-pos:cash-tests": "cd apps/umi-pos && flutter test test/cash_center_test.dart test/checkout_test.dart",
    "umi-pos:sale-db-check": "bash scripts/umi-pos-sale-db-check.sh",
    "umi-pos:checkout-db-check": "bash scripts/umi-pos-checkout-db-check.sh",
    "umi-pos:cash-db-check": "bash scripts/umi-pos-cash-db-check.sh",
    "umi-pos:exception-api-tests": "pnpm --filter @umi/api exec vitest run src/modules/pos-exception/refund-calculator.spec.ts src/modules/pos-exception/pos-exception.service.spec.ts src/shared/database/gate-3d-exception-migration.spec.ts",
    "umi-pos:exception-tests": "cd apps/umi-pos && flutter test test/sale_exception_test.dart",
    "umi-pos:exception-db-check": "bash scripts/umi-pos-exception-db-check.sh",
    "umi-pos:inventory-db-check": "bash scripts/umi-pos-inventory-db-check.sh",
    "umi-pos:inventory-api-tests": "pnpm --filter @umi/api exec vitest run src/modules/pos-inventory/inventory-domain.spec.ts src/modules/pos-inventory/pos-inventory.service.spec.ts src/shared/database/gate-3e-inventory-migration.spec.ts src/modules/pos-checkout/pos-checkout.service.spec.ts src/modules/pos-exception/pos-exception.service.spec.ts",
    "umi-pos:inventory-tests": "cd apps/umi-pos && flutter test test/inventory_test.dart test/catalog_test.dart test/checkout_test.dart",
    "umi-pos:customer-value-db-check": "bash scripts/umi-pos-customer-value-db-check.sh",
    "umi-pos:customer-value-concurrency-check": "bash scripts/umi-pos-customer-value-concurrency-check.sh",
    "umi-pos:kds-concurrency-check": "bash scripts/umi-pos-kds-concurrency-check.sh",
    "umi-pos:customer-value-api-tests": "pnpm --filter @umi/api exec vitest run src/modules/pos-customer-value/customer-value-domain.spec.ts src/modules/pos-customer-value/pos-customer-value.service.spec.ts src/shared/database/gate-3f-customer-value-migration.spec.ts src/shared/database/gate-3f-customer-value-concurrency.spec.ts src/jobs/customer-value-expiry.scheduler.spec.ts src/modules/pos-checkout/checkout-calculator.spec.ts src/modules/pos-checkout/pos-checkout.service.spec.ts src/modules/pos-exception/pos-exception.service.spec.ts",
    "umi-pos:customer-value-tests": "cd apps/umi-pos && flutter test test/customer_value_test.dart test/checkout_test.dart test/sale_lifecycle_test.dart",
    "umi-pos:hardware-api-tests": "pnpm --filter @umi/api exec vitest run src/modules/pos-hardware/pos-hardware.service.spec.ts src/shared/database/gate-3g-hardware-migration.spec.ts",
    "umi-pos:hardware-tests": "cd apps/umi-pos && flutter test test/hardware_runtime_test.dart test/hardware_service_test.dart test/checkout_test.dart test/sale_exception_test.dart test/cash_center_test.dart test/security_boundaries_test.dart",
    "umi-pos:hardware-db-check": "bash scripts/umi-pos-db-check.sh",
    "umi-pos:generate-pilot-rbac": "node scripts/umipos-pilot-rbac.mjs generate",
    "umi-pos:check-pilot-rbac": "node scripts/umipos-pilot-rbac.mjs check",
    "umi-pos:print-role-matrix": "node scripts/umipos-pilot-rbac.mjs print",
    "umi-pos:seed-pilot-roles": "bash scripts/umi-pos-local-access-seed.sh && bash scripts/umi-pos-demo-seed.sh",
    "umi-pos:rbac-api-tests": "pnpm --filter @umi/api exec vitest run src/modules/auth/pilot-rbac.spec.ts src/modules/auth/roles.spec.ts src/modules/auth/guards.spec.ts src/modules/pos-entry/pos-entry.service.spec.ts src/modules/pos-sale/pos-sale.service.spec.ts src/modules/pos-checkout/pos-checkout.service.spec.ts src/modules/pos-cash/pos-cash.service.spec.ts src/modules/pos-exception/pos-exception.service.spec.ts",
    "umi-pos:rbac-db-check": "bash scripts/umi-pos-db-check.sh",
    "umipos:pilot:precheck": "bash scripts/umipos-pilot.sh precheck",
    "umipos:pilot:build": "bash scripts/umipos-pilot.sh build",
    "umipos:pilot:deploy": "bash scripts/umipos-pilot.sh deploy",
    "umipos:pilot:smoke": "bash scripts/umipos-pilot.sh smoke",
    "umipos:pilot:certify-clean": "bash scripts/umipos-pilot.sh certify-clean",
    "umipos:pilot:certify-business": "bash scripts/umipos-pilot.sh certify-business",
    "umipos:pilot:backup": "bash scripts/umipos-pilot.sh backup",
    "umipos:pilot:runtime-tests": "node --test scripts/umipos-pilot-runtime.spec.mjs",
    "umipos:pilot:update-check": "node scripts/umipos-update-check.mjs",
    "pilot:readiness": "node scripts/umipos-pilot-readiness.mjs",
    "pilot:readiness:test": "node --test scripts/umipos-pilot-readiness.spec.mjs scripts/umipos-pilot-fixture.spec.mjs",
    "pilot:bootstrap": "bash scripts/umipos-pilot-bootstrap.sh"
  },
  "devDependencies": {
    "prettier": "3.9.4",
    "turbo": "^2.8.8"
  }
}
