{
  "name": "umi-workspace",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint --continue",
    "check:lint-warnings": "node scripts/check-lint-warning-baseline.mjs",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:pr": "pnpm --filter @umi/contract generate:check && pnpm lint && pnpm check:lint-warnings && pnpm format:check && node scripts/check-pr.mjs && node scripts/check-umipos-use-cases.mjs",
    "db:build-v3": "bash docs/migration/build-v3/00_run.sh",
    "db:pos-check": "bash scripts/umi-pos-db-check.sh",
    "umi-pos:get": "cd apps/umi-pos && flutter pub get",
    "umi-pos:generate": "pnpm --filter @umi/contract generate && cd apps/umi-pos && flutter gen-l10n",
    "umi-pos:linux": "cd apps/umi-pos && flutter run -d linux",
    "umi-pos:macos": "cd apps/umi-pos && flutter run -d macos",
    "umi-pos:windows": "cd apps/umi-pos && flutter run -d windows",
    "umi-pos:android": "cd apps/umi-pos && flutter run -d android",
    "umi-pos:ios": "cd apps/umi-pos && flutter run -d ios",
    "umi-pos:web": "cd apps/umi-pos && flutter run -d chrome",
    "umi-pos:offline-tests": "cd apps/umi-pos && flutter test test/offline_journal_test.dart test/offline_policy_test.dart test/checkout_test.dart",
    "umi-pos:replay-api-tests": "pnpm --filter @umi/api exec vitest run src/modules/pos-offline/pos-offline.service.spec.ts",
    "umi-pos:pairing-db-check": "bash scripts/umi-pos-device-pairing-db-check.sh",
    "umi-pos:offline-db-check": "bash scripts/umi-pos-offline-db-check.sh",
    "umi-pos:pairing-tests": "cd apps/umi-pos && flutter test test/device_pairing_test.dart",
    "umi-pos:pairing-api-tests": "pnpm --filter @umi/api exec vitest run src/modules/devices/devices.service.spec.ts src/shared/database/device-pairing-migration.spec.ts",
    "umi-pos:local-access-seed": "bash scripts/umi-pos-local-access-seed.sh",
    "umi-pos:demo-seed": "bash scripts/umi-pos-demo-seed.sh",
    "umi-pos:sale-api-tests": "pnpm --filter @umi/api exec vitest run src/modules/pos-sale/pos-sale.service.spec.ts src/modules/pos-cart/pos-cart.service.spec.ts src/modules/pos-checkout/pos-checkout.service.spec.ts",
    "umi-pos:sale-tests": "cd apps/umi-pos && flutter test test/sale_lifecycle_test.dart test/cart_test.dart test/checkout_test.dart test/catalog_test.dart test/navigation_test.dart",
    "umi-pos:checkout-api-tests": "pnpm --filter @umi/api exec vitest run src/modules/pos-checkout/checkout-calculator.spec.ts src/modules/pos-checkout/pos-checkout.service.spec.ts src/modules/pos-checkout/pos-checkout.repository.spec.ts src/modules/pos-entry/pos-entry.service.spec.ts",
    "umi-pos:checkout-tests": "cd apps/umi-pos && flutter test test/checkout_test.dart test/sale_lifecycle_test.dart",
    "umi-pos:cash-api-tests": "pnpm --filter @umi/api exec vitest run src/modules/pos-cash/cash-domain.spec.ts src/modules/pos-cash/pos-cash.service.spec.ts src/modules/pos-checkout/pos-checkout.repository.spec.ts",
    "umi-pos:cash-tests": "cd apps/umi-pos && flutter test test/cash_center_test.dart test/checkout_test.dart",
    "umi-pos:sale-db-check": "bash scripts/umi-pos-sale-db-check.sh",
    "umi-pos:checkout-db-check": "bash scripts/umi-pos-checkout-db-check.sh",
    "umi-pos:cash-db-check": "bash scripts/umi-pos-cash-db-check.sh",
    "umi-pos:exception-api-tests": "pnpm --filter @umi/api exec vitest run src/modules/pos-exception/refund-calculator.spec.ts src/modules/pos-exception/pos-exception.service.spec.ts src/shared/database/gate-3d-exception-migration.spec.ts",
    "umi-pos:exception-tests": "cd apps/umi-pos && flutter test test/sale_exception_test.dart",
    "umi-pos:exception-db-check": "bash scripts/umi-pos-exception-db-check.sh"
  },
  "devDependencies": {
    "prettier": "3.9.4",
    "turbo": "^2.8.8"
  }
}
