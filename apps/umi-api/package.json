{
  "name": "@umi/api",
  "version": "0.1.0",
  "private": true,
  "description": "Umi centralized backend API (NestJS + Fastify). One service, two processes: web (HTTP) and worker (BullMQ).",
  "files": [
    "dist",
    "passes"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:schema": "vitest run --config vitest.integration.config.ts src/shared/database/sql-preflight.integration.ts src/shared/database/check-values.integration.ts src/shared/database/schema-parity.integration.ts src/modules/wallet/wallet-carry.integration.ts src/shared/loyalty/loyalty-stamps.integration.ts src/modules/cash/cash-seals.integration.ts src/modules/cash/cash-logout.integration.ts src/modules/cash/cash-login.integration.ts src/modules/auth/credential-upgrade.integration.ts src/modules/cash/register-flip.integration.ts",
    "test:integration:migration": "vitest run --config vitest.integration.config.ts src/shared/database/rls.integration.ts src/shared/database/pooler-isolation.integration.ts src/shared/database/identity-normalization.integration.ts src/smoke.integration.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@fastify/cookie": "^11.0.2",
    "@nestjs/bullmq": "^11.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@umi/contract": "workspace:*",
    "bullmq": "^5.34.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "fastify": "^5.8.5",
    "jose": "^6.2.3",
    "nodemailer": "^9.0.1",
    "passkit-generator": "^3.3.1",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.2.1",
    "@swc/core": "^1.16.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "unplugin-swc": "^1.5.11",
    "vitest": "^2.1.8"
  }
}
