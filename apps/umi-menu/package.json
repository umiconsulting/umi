{
  "name": "@umi/menu",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "python3 scripts/serve.py",
    "build": "node scripts/build.cjs",
    "test": "node --test tests/*.test.cjs",
    "check": "node --check src/base.js && node --check src/state.js && node --check src/app.js && node --check src/visual.js && node --check src/navigation.js && node --check scripts/build.cjs",
    "predev": "pnpm run build",
    "prebuild": "pnpm --filter @umi/contract build:runtime",
    "pretest": "pnpm --filter @umi/contract build:runtime"
  },
  "dependencies": {
    "@umi/contract": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
