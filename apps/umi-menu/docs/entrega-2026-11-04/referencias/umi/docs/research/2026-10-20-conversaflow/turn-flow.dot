digraph TurnFlow {
  graph [rankdir=TB, bgcolor="#ffffff", pad="0.4", nodesep="0.42", ranksep="0.6", splines=polyline, fontname="Arial", fontsize=22, fontcolor="#10243a", labelloc=t, label="Conversaflow | One customer turn\nCode path, persistence, tool calls, and billable work"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=12, margin="0.2,0.15", color="#c5d3e2", fillcolor="#f5f8fc", fontcolor="#10243a"];
  edge [fontname="Arial", fontsize=10, color="#6c8094", fontcolor="#445b72", arrowsize=0.7];

  inbound [label="1 | Twilio -> POST /conversations/whatsapp\nValidate signature, resolve merchant + customer\nRate limits, input checks, MessageSid dedup", fillcolor="#e3efff"];
  persist [label="2 | Persist customer message in PostgreSQL\nEnqueue turn.integrity in Redis\nReturn empty TwiML; reply follows asynchronously", fillcolor="#e4f6f1"];
  integrity [label="3 | turns queue: turn.integrity\nMerge closely spaced customer messages\nHold window: 1-3 seconds\nEnqueue turn.process", fillcolor="#eee8fc"];
  lock [label="4 | turns queue: turn.process\nAcquire one lock per conversation\nLoad cart, customer, merchant voice, hours, location", fillcolor="#eee8fc"];
  memory [label="5 | Build working memory\nLast 8 messages + customer facts + summary\nUp to 5 retrieved memories\nSemantic query uses Voyage when applicable", fillcolor="#e4f6f1"];
  llm [label="6 | Anthropic: Haiku 4.5 tool loop\nHistory + prompt + tool definitions\nConfigured tool budget: 4\nAutomatic checks can add calls\nEach model call adds billable input/output tokens", fillcolor="#fff0d9", color="#e8c38e"];
  tools [label="Backend tools | Local service calls\nset_location; merchant info; business hours\nsearch_menu; add_to_cart; edit_cart\nconfirm_order; confirm_order_changes; cancel_order\nget_recent_customer_orders; reorder_last_order\nValidate catalog, price, hours, and confirmation\nWrite orders through the shared order writer", fillcolor="#eee8fc"];
  newer [label="7 | Check for newer customer messages\nIf newer work exists, supersede and requeue\nOtherwise sanitize the final reply", fillcolor="#eee8fc"];
  commit [label="8 | One PostgreSQL transaction\nInsert bot message + runtime.outbox_event\nDeduplicate by reply idempotency key", fillcolor="#e4f6f1"];
  relay [label="9 | Outbox relay -> outbound queue\nDeterministic job ID\nOutbox acknowledgement means queued", fillcolor="#eee8fc"];
  send [label="10 | Outbound worker -> Twilio REST\nTwilio acceptance returns MessageSid\nTwilio retries: up to 5 job attempts\nTerminal failures enter runtime.dead_letter", fillcolor="#fff0d9", color="#e8c38e"];
  customer [label="Customer receives WhatsApp reply\nDelivered/read status needs a provider callback\nThat callback is a proposed addition", fillcolor="#e3efff"];
  enrich [label="Background enrichment after reply commit\nmessage.embed -> Voyage -> pgvector\ncustomer.extract_facts -> one-shot LLM\nconversation.summarize -> LLM after >8 messages\nFacts and summaries default to Haiku\nOptional DeepSeek applies to these one-shot calls", fillcolor="#fff0d9", color="#e8c38e"];
  live [label="Dashboard refresh\nPostgreSQL NOTIFY -> /rt/dashboard\ndashboard.conversation.message event\nBrowser re-reads transcript through scoped REST", fillcolor="#e3efff"];
  usage [label="Usage and operations\numi.ai_usage: reply, facts, summary, portraits\nIncludes aggregate tokens across successful loop calls\nProvider bills remain the reconciliation source\nIntentService is present but has no runtime caller", fillcolor="#f0f3f7"];

  inbound -> persist -> integrity -> lock -> memory -> llm;
  llm -> tools [label="tool request"];
  tools -> llm [label="tool result", constraint=false];
  llm -> newer [label="final text"];
  newer -> integrity [label="newer customer text", style=dashed, constraint=false];
  newer -> commit -> relay -> send -> customer;
  commit -> enrich [label="async jobs"];
  persist -> live [label="customer insert", style=dashed, constraint=false];
  commit -> live [label="bot insert", style=dashed];
  llm -> usage [label="tokens and calls", style=dashed];
  enrich -> usage [label="facts and summary usage", style=dashed];
}
