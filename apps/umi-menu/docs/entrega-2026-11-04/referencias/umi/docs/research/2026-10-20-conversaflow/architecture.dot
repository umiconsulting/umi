digraph Conversaflow {
  graph [rankdir=TB, bgcolor="#ffffff", pad="0.4", nodesep="0.48", ranksep="0.8", splines=polyline, fontname="Arial", fontsize=22, fontcolor="#10243a", labelloc=t, label="Conversaflow | Standalone deployment\nTarget layout using the current code | 20 October 2026", compound=true];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=13, margin="0.22,0.17", color="#c5d3e2", fillcolor="#f5f8fc", fontcolor="#10243a", penwidth=1.3];
  edge [fontname="Arial", fontsize=10, color="#6c8094", fontcolor="#445b72", arrowsize=0.75, penwidth=1.25];

  subgraph cluster_front {
    label="FRONTEND"; fontsize=15; style="rounded,filled"; color="#c6dcf6"; fillcolor="#f5f9ff";
    customer [label="Customer\nWhatsApp app", fillcolor="#e3efff"];
    owner [label="Owner / staff browser\nReact 18 + Vite 5 dashboard\nAttention queue, transcripts, customers\nHours, bot voice, menu, orders", fillcolor="#e3efff"];
    static [label="Cloudflare Pages + Worker\nDashboard bundle; optional API proxy\nFree tier subject to Worker quotas\nNo database or provider secrets", fillcolor="#e3efff"];
    owner -> static [label="load application", dir=both];
  }

  twilio [label="Meta WhatsApp + Twilio\nBusiness number and messaging account\nInbound webhooks + outbound REST\nTwilio fee + Meta fee", fillcolor="#fff0d9", color="#e8c38e"];

  subgraph cluster_host {
    label="OWN VPS | One deployment, separate API and worker processes"; fontsize=16; style="rounded,filled"; color="#bccce0"; fillcolor="#fafbfd";
    caddy [label="Caddy\nPublic HTTPS :443\nAPI host: proxy all API paths\nInclude /conversations/* + /socket.io/*", fillcolor="#edf2f8"];
    api [label="API process | NestJS 11 + Fastify\nPOST /conversations/whatsapp\nAuth + merchant-scoped REST\nSocket.IO namespace /rt/dashboard", fillcolor="#e3efff", color="#95b9e5"];
    redis [label="Redis 7.4 + BullMQ 5\nTurns, enrichment, outbound\nOptional integrations + lifecycle\nJob retries, locks, AOF persistence", fillcolor="#e4f6f1", color="#9ecfbe"];
    worker [label="Worker process | Same backend image\n1. Merge customer messages into a turn\n2. Load memory and run AI + tools\n3. Commit reply and outbox\n4. Send reply through Twilio\n5. Embed messages, extract facts, summarize", fillcolor="#eee8fc", color="#b5a0de"];
    postgres [shape=cylinder, label="PostgreSQL 16 + pgvector\nmerchant: customers, chats, catalog, orders\nruntime: turns, cart, vectors, outbox, failures\numi: users, access, entitlements, AI usage\nPersistent volumes + database migrations", fillcolor="#e4f6f1", color="#9ecfbe"];
    caddy -> api [label="HTTP + WebSocket upgrade"];
    api -> redis [label="enqueue turn.integrity"];
    redis -> worker [label="consume jobs"];
    api -> postgres [label="identity, messages, reads"];
    worker -> postgres [label="memory, tools, commits", dir=both];
    worker -> redis [label="follow-up jobs", constraint=false];
    postgres -> api [label="LISTEN / NOTIFY\nIDs trigger REST refresh", constraint=false];
  }

  subgraph cluster_ai {
    label="HOSTED AI APIs"; fontsize=15; style="rounded,filled"; color="#e8c38e"; fillcolor="#fffbf5";
    claude [label="Anthropic | Claude Haiku 4.5\nReply and tool loop\nDefault facts and summaries\nToken-based cost", fillcolor="#fff0d9", color="#e8c38e"];
    voyage [label="Voyage | voyage-4-lite\nMessage and product embeddings\nSemantic search queries\nVectors stay in PostgreSQL", fillcolor="#fff0d9", color="#e8c38e"];
    deepseek [label="Optional DeepSeek\nOne-shot facts, summaries, portraits\nReply loop still uses Anthropic", style="rounded,filled,dashed", fillcolor="#fff8ed", color="#d2bd9c"];
  }

  subgraph cluster_ops {
    label="OPERATIONS"; fontsize=15; style="rounded,filled"; color="#d4dbe3"; fillcolor="#fbfcfd";
    telemetry [label="Logs + OpenTelemetry\nHealth, errors, queue age, AI usage\nAlerts and recovery procedures", fillcolor="#f0f3f7"];
    backup [label="Backups outside the VPS\nDatabase + deployment configuration\nRetention and restore verification", fillcolor="#f0f3f7"];
  }

  fulfillment [label="Optional UmiPOS / kitchen\nOrders and fulfillment status\nUses existing Umi API contracts", style="rounded,filled,dashed", fillcolor="#f0f3f7"];
  zettle [label="Optional Zettle catalog import\nProducts API -> product embeddings\nExisting code uses one configured account", style="rounded,filled,dashed", fillcolor="#f0f3f7"];

  customer -> twilio [label="customer messages"];
  twilio -> customer [label="business replies", constraint=false];
  twilio -> caddy [label="signed form webhook"];
  owner -> caddy [label="cookie-authenticated REST\n+ /rt/dashboard socket"];
  worker -> twilio [label="POST Messages.json\nAPI acceptance returns MessageSid", constraint=false, color="#ba8b49"];
  worker -> claude [label="messages + tools", dir=both];
  worker -> voyage [label="embeddings", dir=both];
  worker -> deepseek [label="optional LLM_PROVIDER", style=dashed];
  worker -> zettle [label="optional zettle.sync", dir=both, style=dashed];
  fulfillment -> caddy [label="optional REST / board watch", dir=both, style=dashed, constraint=false];
  api -> telemetry [style=dashed];
  worker -> telemetry [style=dashed];
  postgres -> backup [style=dashed];

  note [shape=note, label="SCOPE\nSolid = core runtime path. Dashed = optional or operational path.\nStandalone hosting reuses Umi API, worker, schemas, and dashboard.\nCode is not yet a separate Conversaflow package.\nFresh database: bootstrap the first merchant and owner.\nThe pilot proxy needs webhook and Socket.IO route changes.\nDelivery receipts, manual reply, and takeover APIs are proposed additions.\nExact endpoints, prerequisites, gaps, and prices are in the accompanying report.", fillcolor="#fffdf3", color="#d9cfaa", fontsize=11];
  backup -> note [style=invis];
  deepseek -> note [style=invis];
}
