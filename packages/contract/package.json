{
  "name": "@umi/contract",
  "version": "0.1.0",
  "private": true,
  "description": "Typed HTTP contract (route paths + zod schemas + inferred types) shared by umi-api and umi-dashboard so the API surface can't drift.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./routes": {
      "types": "./dist/routes.d.ts",
      "import": "./dist/routes.js",
      "require": "./dist/routes.cjs"
    },
    "./entitlements": {
      "types": "./dist/entitlements.d.ts",
      "import": "./dist/entitlements.js",
      "require": "./dist/entitlements.cjs"
    },
    "./platform": {
      "types": "./dist/platform.d.ts",
      "import": "./dist/platform.js",
      "require": "./dist/platform.cjs"
    },
    "./route-table": {
      "types": "./dist/route-table.d.ts",
      "import": "./dist/route-table.js",
      "require": "./dist/route-table.cjs"
    },
    "./realtime-channels": {
      "types": "./dist/realtime-channels.d.ts",
      "import": "./dist/realtime-channels.js",
      "require": "./dist/realtime-channels.cjs"
    }
  },
  "scripts": {
    "build:runtime": "tsup",
    "generate": "pnpm run build:runtime && node scripts/generate.mjs",
    "generate:check": "pnpm run build:runtime && node scripts/generate.mjs --check",
    "build": "pnpm run generate && tsup",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "files": [
    "dist",
    "src",
    "generated"
  ]
}
