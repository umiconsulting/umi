{
  "$description": "umi-dashboard (Vite/React operator console) design tokens. Token keys ARE the exact CSS custom-property names (minus the leading --), so the generator reproduces --umi-navy … --ease 1:1. The :root block is the default 'Umi' theme (the original light palette, captured verbatim from apps/umi-dashboard/src/styles.css :root). Alternate NAMED themes live on each leaf under $themes: { <theme>: <value> }; the generator emits one [data-theme=\"<theme>\"] block per theme name. A token with no $themes entry keeps its Umi value in every theme — brand hues, radii, fonts and motion are theme-invariant on purpose. Divergent-from-landing values live here on purpose; convergence is an explicit owner commit (see README drift register). Non-color $type values (shadow, cubicBezier) are stored as raw CSS strings rather than DTCG composites.",
  "$themeMeta": {
    "$description": "Theme registry. default is the :root theme; order drives the theme picker; prefersDark names the theme applied under an OS dark preference when the operator has made no explicit choice.",
    "default": "umi",
    "order": ["umi", "midnight"],
    "prefersDark": "midnight",
    "labels": { "umi": "Umi", "midnight": "Midnight" }
  },
  "brand": {
    "$description": "Brand",
    "umi-navy": { "$type": "color", "$value": "{color.navy}" },
    "umi-navy-deep": { "$type": "color", "$value": "#1a2c5e" },
    "umi-navy-ink": { "$type": "color", "$value": "#131f44" },
    "umi-blue": { "$type": "color", "$value": "{color.blue}" },
    "umi-blue-soft": { "$type": "color", "$value": "#a8bbde" },
    "umi-neutral": { "$type": "color", "$value": "#EEF1F8" },
    "umi-white": { "$type": "color", "$value": "#ffffff" }
  },
  "surface": {
    "$description": "Surfaces (Umi light shell)",
    "canvas": { "$type": "color", "$value": "#EEF1F8", "$themes": { "midnight": "#000000" } },
    "canvas-2": { "$type": "color", "$value": "#E4E9F3", "$themes": { "midnight": "#0D0D0D" } },
    "surface": { "$type": "color", "$value": "#ffffff", "$themes": { "midnight": "#000000" } },
    "surface-warm": { "$type": "color", "$value": "#FAF4EC", "$themes": { "midnight": "#000000" } },
    "surface-warm-border": { "$type": "color", "$value": "#EAE0D3", "$themes": { "midnight": "#2A2A2A" } },
    "sidebar-bg": { "$type": "color", "$value": "#1a2952", "$themes": { "midnight": "#000000" } },
    "sidebar-bg-deep": { "$type": "color", "$value": "#131f44", "$themes": { "midnight": "#000000" } }
  },
  "ink": {
    "$description": "Ink",
    "ink-1": { "$type": "color", "$value": "#131f44", "$themes": { "midnight": "#F2F2F2" } },
    "ink-2": { "$type": "color", "$value": "#4a5680", "$themes": { "midnight": "#B0B0B0" } },
    "ink-3": { "$type": "color", "$value": "#5C678F", "$themes": { "midnight": "#8A8A8A" } },
    "ink-4": { "$type": "color", "$value": "#7D8AAE", "$themes": { "midnight": "#6A6A6A" } },
    "ink-warm": { "$type": "color", "$value": "#1F1410", "$themes": { "midnight": "#EDEDED" } },
    "ink-warm-soft": { "$type": "color", "$value": "#6e5a4a", "$themes": { "midnight": "#A0A0A0" } },
    "ink-warm-mute": { "$type": "color", "$value": "#C4A882", "$themes": { "midnight": "#6E6E6E" } }
  },
  "sidebar-text": {
    "$description": "Sidebar text",
    "side-text-1": { "$type": "color", "$value": "#f0f4ff" },
    "side-text-2": { "$type": "color", "$value": "rgba(240, 244, 255, 0.62)" },
    "side-text-3": { "$type": "color", "$value": "rgba(240, 244, 255, 0.34)" },
    "side-line": { "$type": "color", "$value": "rgba(255, 255, 255, 0.08)" }
  },
  "line": {
    "$description": "Lines",
    "line": { "$type": "color", "$value": "#DDE3F0", "$themes": { "midnight": "#2A2A2A" } },
    "line-soft": { "$type": "color", "$value": "#E8ECF5", "$themes": { "midnight": "#1C1C1C" } },
    "line-strong": { "$type": "color", "$value": "#C8D1E5", "$themes": { "midnight": "#3A3A3A" } }
  },
  "status": {
    "$description": "Status",
    "success": { "$type": "color", "$value": "#447644", "$themes": { "midnight": "#62B36B" } },
    "success-soft": { "$type": "color", "$value": "#E4F0E1", "$themes": { "midnight": "#12211A" } },
    "danger": { "$type": "color", "$value": "#B33A35", "$themes": { "midnight": "#E5706B" } },
    "danger-soft": { "$type": "color", "$value": "#F4DEDB", "$themes": { "midnight": "#251312" } },
    "warning": { "$type": "color", "$value": "#8F6621", "$themes": { "midnight": "#D9A441" } },
    "warning-soft": { "$type": "color", "$value": "#F6E9D0", "$themes": { "midnight": "#241D10" } },
    "info": { "$type": "color", "$value": "{color.blue}", "$themes": { "midnight": "#7FA2E0" } },
    "info-soft": { "$type": "color", "$value": "#DEE6F4", "$themes": { "midnight": "#131A26" } }
  },
  "tenant": {
    "$description": "Tenant brand default (warm)",
    "tenant-brand": { "$type": "color", "$value": "#B5605A", "$themes": { "midnight": "#C77B72" } }
  },
  "radius": {
    "$description": "Radii",
    "r-pill": { "$type": "dimension", "$value": "9999px" },
    "r-lg": { "$type": "dimension", "$value": "12px" },
    "r-xl": { "$type": "dimension", "$value": "16px" },
    "r-card": { "$type": "dimension", "$value": "20px" },
    "r-shell": { "$type": "dimension", "$value": "28px" }
  },
  "shadow": {
    "$description": "Shadows",
    "shadow-card": {
      "$type": "shadow",
      "$value": "0 1px 2px rgba(19, 31, 68, 0.04)",
      "$themes": { "midnight": "0 1px 2px rgba(0, 0, 0, 0.5)" }
    },
    "shadow-pop": {
      "$type": "shadow",
      "$value": "0 24px 60px -24px rgba(19, 31, 68, 0.32), 0 2px 8px rgba(19, 31, 68, 0.06)",
      "$themes": { "midnight": "0 24px 60px -24px rgba(0, 0, 0, 0.8), 0 2px 8px rgba(0, 0, 0, 0.5)" }
    },
    "shadow-inner": {
      "$type": "shadow",
      "$value": "inset 0 0 0 1px rgba(19, 31, 68, 0.05)",
      "$themes": { "midnight": "inset 0 0 0 1px rgba(255, 255, 255, 0.06)" }
    }
  },
  "typography": {
    "$description": "Typography",
    "font-display": {
      "$type": "fontFamily",
      "$value": "\"Fraunces\", \"Source Serif 4\", Georgia, serif"
    },
    "font-body": {
      "$type": "fontFamily",
      "$value": "\"Source Sans 3\", \"Source Sans Pro\", system-ui, sans-serif"
    },
    "font-mono": {
      "$type": "fontFamily",
      "$value": "\"JetBrains Mono\", ui-monospace, \"SF Mono\", monospace"
    }
  },
  "motion": {
    "$description": "Motion",
    "ease": { "$type": "cubicBezier", "$value": "cubic-bezier(.2,.7,.2,1)" },
    "ease-out": { "$type": "cubicBezier", "$value": "cubic-bezier(.16,1,.3,1)" },
    "dur-1": { "$type": "duration", "$value": "120ms" },
    "dur-2": { "$type": "duration", "$value": "220ms" },
    "dur-3": { "$type": "duration", "$value": "320ms" }
  }
}
