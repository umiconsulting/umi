    },
    "danger": {
      "$type": "color",
      "$value": "#AC312A",
      "$themes": { "dark": "#ED7668", "midnight": "#ED7668" }
    },
    "danger-soft": {
      "$type": "color",
      "$value": "#FDE9E6",
      "$themes": { "dark": "#331511", "midnight": "#331511" }
    },
    "warning": {
      "$type": "color",
      "$value": "#8A5F18",
      "$themes": { "dark": "#FCBE62", "midnight": "#FCBE62" }
    },
    "warning-soft": {
      "$type": "color",
      "$value": "#FAE4C7",
      "$themes": { "dark": "#2E1E06", "midnight": "#2E1E06" }
    },
    "info": {
      "$type": "color",
      "$value": "#1F6CB0",
      "$themes": { "dark": "#67AAED", "midnight": "#67AAED" }
    },
    "info-soft": {
      "$type": "color",
      "$value": "#E5F0FC",
      "$themes": { "dark": "#0D2034", "midnight": "#0D2034" }
    }
  },
  "tenant": {
    "$description": "Tenant brand default (warm)",
    "tenant-brand": {
      "$type": "color",
      "$value": "#B5605A",
      "$themes": { "dark": "#C77B72", "midnight": "#C77B72" }
    }
  },
  "radius": {
    "$description": "Radii",
    "r-pill": { "$type": "dimension", "$value": "9999px" },
    "r-lg": { "$type": "dimension", "$value": "12px" },
    "r-xl": { "$type": "dimension", "$value": "16px" },
    "r-card": { "$type": "dimension", "$value": "20px" },
    "r-shell": { "$type": "dimension", "$value": "28px" }
  },
  "shadow": {
    "$description": "Shadows",
    "shadow-card": {
      "$type": "shadow",
      "$value": "0 1px 2px rgba(19, 31, 68, 0.04)",
      "$themes": {
        "dark": "0 1px 2px rgba(0, 0, 0, 0.5)",
        "midnight": "0 1px 2px rgba(0, 0, 0, 0.5)"
      }
    },
    "shadow-pop": {
      "$type": "shadow",
      "$value": "0 24px 60px -24px rgba(19, 31, 68, 0.32), 0 2px 8px rgba(19, 31, 68, 0.06)",
      "$themes": {
        "dark": "0 24px 60px -24px rgba(0, 0, 0, 0.8), 0 2px 8px rgba(0, 0, 0, 0.5)",
        "midnight": "0 24px 60px -24px rgba(0, 0, 0, 0.8), 0 2px 8px rgba(0, 0, 0, 0.5)"
      }
    },
    "shadow-inner": {
      "$type": "shadow",
      "$value": "inset 0 0 0 1px rgba(19, 31, 68, 0.05)",
      "$themes": {
        "dark": "inset 0 0 0 1px rgba(255, 255, 255, 0.06)",
        "midnight": "inset 0 0 0 1px rgba(255, 255, 255, 0.06)"
      }
    }
  },
  "typography": {
    "$description": "Typography",
    "font-display": {
      "$type": "fontFamily",
      "$value": "\"Inter Tight\", \"Inter\", system-ui, sans-serif"
    },
    "font-body": {
      "$type": "fontFamily",
      "$value": "\"Source Sans 3\", \"Source Sans Pro\", system-ui, sans-serif"
    },
    "font-mono": {
      "$type": "fontFamily",
      "$value": "\"JetBrains Mono\", ui-monospace, \"SF Mono\", monospace"
    }
  },
  "motion": {
    "$description": "Motion",
    "ease": { "$type": "cubicBezier", "$value": "cubic-bezier(.2,.7,.2,1)" },
    "ease-out": { "$type": "cubicBezier", "$value": "cubic-bezier(.16,1,.3,1)" },
    "dur-1": { "$type": "duration", "$value": "120ms" },
    "dur-2": { "$type": "duration", "$value": "220ms" },
    "dur-3": { "$type": "duration", "$value": "320ms" }
  }
}
