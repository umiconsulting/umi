{
  "$description": "umi-dashboard (Vite/React operator console) design tokens. Token keys ARE the exact CSS custom-property names (minus the leading --), so the generator reproduces --umi-navy … --ease 1:1. The :root block is the default 'Umi' theme (the original light palette, captured verbatim from apps/umi-dashboard/src/styles.css :root). Alternate NAMED themes live on each leaf under $themes: { <theme>: <value> }; the generator emits one [data-theme=\"<theme>\"] block per theme name. A token with no $themes entry keeps its Umi value in every theme — brand hues, radii, fonts and motion are theme-invariant on purpose. Divergent-from-landing values live here on purpose; convergence is an explicit owner commit (see README drift register). Non-color $type values (shadow, cubicBezier) are stored as raw CSS strings rather than DTCG composites.",
  "$themeMeta": {
    "$description": "Theme registry. default is the :root theme; order drives the theme picker; prefersDark names the theme applied under an OS dark preference when the operator has made no explicit choice.",
    "default": "umi",
    "order": ["umi", "dark", "midnight"],
    "prefersDark": "dark",
    "labels": { "umi": "Umi", "dark": "Oscuro", "midnight": "Midnight" }
  },
  "brand": {
    "$description": "Brand",
    "umi-navy": { "$type": "color", "$value": "{color.navy}" },
    "umi-navy-deep": { "$type": "color", "$value": "#1a2c5e" },
    "umi-navy-ink": { "$type": "color", "$value": "#131f44" },
    "umi-blue": { "$type": "color", "$value": "{color.blue}" },
    "umi-blue-soft": { "$type": "color", "$value": "#a8bbde" },
    "umi-neutral": { "$type": "color", "$value": "#EEF1F8" },
    "umi-white": { "$type": "color", "$value": "#ffffff" }
  },
  "surface": {
    "$description": "Surfaces (Umi light shell)",
    "canvas": {
      "$type": "color",
      "$value": "#EEF1F8",
      "$themes": { "dark": "#070C18", "midnight": "#000000" }
    },
    "canvas-2": {
      "$type": "color",
      "$value": "#E4E9F3",
      "$themes": { "dark": "#0C1322", "midnight": "#0D0D0D" }
    },
    "surface": {
      "$type": "color",
      "$value": "#ffffff",
      "$themes": { "dark": "#0F1728", "midnight": "#000000" }
    },
    "surface-warm": {
      "$type": "color",
      "$value": "#FAF4EC",
      "$themes": { "dark": "#0F1626", "midnight": "#000000" }
    },
    "surface-warm-border": {
      "$type": "color",
      "$value": "#EAE0D3",
      "$themes": { "dark": "#273150", "midnight": "#2A2A2A" }
    },
    "sidebar-bg": {
      "$type": "color",
      "$value": "#1a2952",
      "$themes": { "dark": "#070C16", "midnight": "#000000" }
    },
    "sidebar-bg-deep": {
      "$type": "color",
      "$value": "#131f44",
      "$themes": { "dark": "#04070E", "midnight": "#000000" }
    }
  },
  "ink": {
    "$description": "Ink",
    "ink-1": {
      "$type": "color",
      "$value": "#131f44",
      "$themes": { "dark": "#EDF1F8", "midnight": "#F2F2F2" }
    },
    "ink-2": {
      "$type": "color",
      "$value": "#4a5680",
      "$themes": { "dark": "#99A2B5", "midnight": "#B0B0B0" }
    },
    "ink-3": {
      "$type": "color",
      "$value": "#5C678F",
      "$themes": { "dark": "#727B8F", "midnight": "#8A8A8A" }
    },
    "ink-4": {
      "$type": "color",
      "$value": "#7D8AAE",
      "$themes": { "dark": "#565E70", "midnight": "#6A6A6A" }
    },
    "ink-warm": {
      "$type": "color",
      "$value": "#1F1410",
      "$themes": { "dark": "#EDEDED", "midnight": "#EDEDED" }
    },
    "ink-warm-soft": {
      "$type": "color",
      "$value": "#6e5a4a",
      "$themes": { "dark": "#A0A0A0", "midnight": "#A0A0A0" }
    },
    "ink-warm-mute": {
      "$type": "color",
      "$value": "#C4A882",
      "$themes": { "dark": "#6E6E6E", "midnight": "#6E6E6E" }
    }
  },
  "sidebar-text": {
    "$description": "Sidebar text",
    "side-text-1": { "$type": "color", "$value": "#f0f4ff" },
    "side-text-2": { "$type": "color", "$value": "rgba(240, 244, 255, 0.62)" },
    "side-text-3": { "$type": "color", "$value": "rgba(240, 244, 255, 0.34)" },
    "side-line": { "$type": "color", "$value": "rgba(255, 255, 255, 0.08)" }
  },
  "line": {
    "$description": "Lines",
    "line": {
      "$type": "color",
      "$value": "#DDE3F0",
      "$themes": { "dark": "#1E273D", "midnight": "#2A2A2A" }
    },
    "line-soft": {
      "$type": "color",
      "$value": "#E8ECF5",
      "$themes": { "dark": "#151C2E", "midnight": "#1C1C1C" }
    },
    "line-strong": {
