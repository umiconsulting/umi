{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    ".agents/skills/**",
    "tools/agent-lab/**",
    "tools/verification/**",
    "tools/ux-sweep/**",
    "tools/performance/**",
    ".githooks/**"
  ],
  "workspaces": {
    "apps/umi-dashboard": {
      "entry": ["index.html", "src/main.jsx", "lingui.config.js", "public/_worker.js"],
      "vite": false,
      "project": ["src/**/*.{js,jsx}"],
      "paths": {
        "@/*": ["src/*"],
        "@umi/contract": ["../../packages/contract/src/index.ts"],
        "@umi/tokens": ["../../packages/tokens/dist/index.js"]
      }
    },
    "apps/umi-api": {
      "entry": ["src/main.ts", "src/worker.ts", "scripts/google-wallet/*.mjs"],
      "ignoreDependencies": ["ioredis"]
    },
    "apps/umi-landing-page": {
      "entry": ["functions/**/*.ts"]
    }
  }
}
