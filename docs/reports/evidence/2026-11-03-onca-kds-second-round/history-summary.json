    "completeImplementation": "else if (input.commandType === 'complete') {\n                const eligible = await client.query(`SELECT count(*)::text AS count FROM merchant.kitchen_order_item\n           WHERE merchant_id=$1::uuid AND kitchen_order_id=$2::uuid\n             AND station_id=ANY($3::uuid[]) AND (cardinality($4::uuid[])=0 OR id=ANY($4::uuid[]))\n             AND status='ready' AND station_completed_at IS NULL`, [input.order.merchant_id, input.order.id, stationScope, input.itemIds]);\n                const count = Number(eligible.rows[0]?.count ?? 0);\n                if (count === 0 || (input.itemIds.length > 0 && count !== input.itemIds.length)) {\n                    effectCount = 0;\n                }\n                else {\n                    const effect = await client.query(`UPDATE merchant.kitchen_order_item SET station_completed_at=clock_timestamp(),\n               version=version+1,updated_at=clock_timestamp()\n             WHERE merchant_id=$1::uuid AND kitchen_order_id=$2::uuid\n               AND station_id=ANY($3::uuid[]) AND (cardinality($4::uuid[])=0 OR id=ANY($4::uuid[]))\n               AND status='ready' AND station_completed_at IS NULL`, [input.order.merchant_id, input.order.id, stationScope, input.itemIds]);\n                    effectCount = effect.rowCount ?? 0;\n                }\n            }\n            else if (input.commandType === 'mark_order_ready') {\n                const effect = await client.query(`UPDATE merchant.kitchen_order_item SET status='ready',version=version+1,\n                  ready_at=clock_timestamp(),updated_at=clock_timestamp()\n            WHERE merchant_id=$1::uuid AND kitchen_order_id=$2::uuid\n              AND station_id=ANY($3::uuid[])\n              AND status IN ('queued','preparing') AND course_number <= $4\n            RETURNING id::text`, [input"
